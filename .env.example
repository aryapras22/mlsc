# Copy to .env before running docker compose. Local development values only.

MLSC_LOCAL_POSTGRES_DB=mlsc
MLSC_LOCAL_POSTGRES_USER=mlsc
MLSC_LOCAL_POSTGRES_PASSWORD=mlsc
MLSC_LOCAL_POSTGRES_PORT=55433

# Alphanumeric only: it is embedded in CELERY_BROKER_URL without percent-encoding.
MLSC_LOCAL_REDIS_PASSWORD=mlsc
MLSC_LOCAL_REDIS_PORT=56379

MLSC_LOCAL_API_PORT=8000

# The origin the browser will use. Must match MLSC_LOCAL_FRONTEND_PORT, because the
# frontend proxies the API under its own origin and the value is baked in at build time.
MLSC_LOCAL_FRONTEND_PORT=8080
MLSC_LOCAL_FRONTEND_ORIGIN=http://localhost:8080

# Enrichment, topic labelling and insight generation only. Any OpenAI-compatible
# endpoint works; unset tiers fail when that stage first runs, not at startup.
# MLSC_LLM_INTENT_BASE_URL=http://host.docker.internal:11434/v1
# MLSC_LLM_INTENT_MODEL=llama3.2
# MLSC_LLM_LABELING_BASE_URL=http://host.docker.internal:11434/v1
# MLSC_LLM_LABELING_MODEL=llama3.2
# MLSC_LLM_INSIGHT_BASE_URL=http://host.docker.internal:11434/v1
# MLSC_LLM_INSIGHT_MODEL=llama3.2
